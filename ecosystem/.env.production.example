# Production configuration shared by all six District 12 sites.
#
# Copy this file to a reference of your own and set the same values on every
# Netlify site (Site configuration -> Environment variables). NEXT_PUBLIC_*
# values are inlined at build time, so they must exist before the first build.
# Never commit real keys or secrets.

# --- Demo / sessions -------------------------------------------------------
D12_DEMO_MODE=false
# 32+ characters, identical on every site. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
D12_SESSION_SECRET=
# Shared parent domain so the hub and every subsidiary read the same cookie.
D12_COOKIE_DOMAIN=.district12.co.ug
D12_SESSION_TTL_HOURS=12

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. The hub uses it for provisioning and ingestion.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URLs (must sit under D12_COOKIE_DOMAIN) --------------------------
NEXT_PUBLIC_D12_HUB_URL=https://hub.district12.co.ug
NEXT_PUBLIC_D12_PASSITO_URL=https://passito.district12.co.ug
NEXT_PUBLIC_D12_MARIZ_URL=https://mariz.district12.co.ug
NEXT_PUBLIC_D12_RUB_SHOOTS_URL=https://rubshoots.district12.co.ug
NEXT_PUBLIC_D12_SHOP_FOR_ME_URL=https://shopforme.district12.co.ug
NEXT_PUBLIC_D12_EXPRESSO_POINT_URL=https://expresso.district12.co.ug

# --- Subsidiary ingestion ------------------------------------------------
D12_TENANT_PASSITO_SECRET=
D12_TENANT_MARIZ_SECRET=
D12_TENANT_RUB_SHOOTS_SECRET=
D12_TENANT_SHOP_FOR_ME_SECRET=
D12_TENANT_EXPRESSO_POINT_SECRET=
D12_INGEST_MAX_SKEW_SECONDS=300
D12_TELEMETRY_WORKER_TOKEN=
