# Copy to ecosystem/.env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Identity / sessions
# ---------------------------------------------------------------------------
# Demo mode lets the starter run without a Supabase Auth project. Any password
# is accepted for the seeded accounts; disable it before going live.
D12_DEMO_MODE=true

# HS256 signing key for d12_session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
D12_SESSION_SECRET=
# Leave blank on localhost (cookies are host-scoped, ports do not matter).
# Production: .district12.co.ug so every subsidiary subdomain shares the session.
D12_COOKIE_DOMAIN=
D12_SESSION_TTL_HOURS=12

# URL the tenant middleware redirects to when there is no valid session.
NEXT_PUBLIC_D12_HUB_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Supabase (reuse the existing District 12 project)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Bypasses RLS; used by the hub for provisioning, ingestion
# and warehouse writes. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Subsidiary workspaces
# ---------------------------------------------------------------------------
NEXT_PUBLIC_D12_PASSITO_URL=http://localhost:3001
NEXT_PUBLIC_D12_MARIZ_URL=http://localhost:3002
NEXT_PUBLIC_D12_RUB_SHOOTS_URL=http://localhost:3003
NEXT_PUBLIC_D12_SHOP_FOR_ME_URL=http://localhost:3004
NEXT_PUBLIC_D12_EXPRESSO_POINT_URL=http://localhost:3005

# One HMAC secret per tenant, shared with the central ingestion API.
D12_TENANT_PASSITO_SECRET=
D12_TENANT_MARIZ_SECRET=
D12_TENANT_RUB_SHOOTS_SECRET=
D12_TENANT_SHOP_FOR_ME_SECRET=
D12_TENANT_EXPRESSO_POINT_SECRET=

# ---------------------------------------------------------------------------
# Telemetry / ingestion
# ---------------------------------------------------------------------------
# Reject signed batches whose timestamp is older/newer than this.
D12_INGEST_MAX_SKEW_SECONDS=300
# Optional bearer token for the outbox drain worker (apps/*/worker/telemetry.mjs).
D12_TELEMETRY_WORKER_TOKEN=
